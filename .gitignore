# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/settings.local.json

.vercel
.env*

# committed env dump (removed) — never re-add
env.download

# Load-test scripts that point at production (yoters.site) and their output.
# load-test-read.mjs is committed on purpose: it is reads-only and safe. These
# drive the write/payment path at 2400 concurrent users — not something that
# should sit in a public repo ready to run.
load-test.js
load-test-simple.js
load-test-results.txt

# Security & internal documentation (local development only)
# Audit reports, security reviews, vulnerability assessments
SECURITY_*.md
AUDIT*.md
*_AUDIT.md
DATA_PRIVACY*.md
DEPLOYMENT*.md

# Internal work logs and setup guides
progress.md
SETUP_*.md
TRANSFER.md
IMPLEMENTATION*.md
INVESTIGATION*.md

# Sensitive operational docs (never commit)
CREDENTIALS*.md
SECRETS*.md
TODO*.md
NOTES*.md
DEBUG*.md
TEST*.md
GROWTH_STRATEGY.md

# Stale worktree checkouts of this repo — 200MB+, and test runners walk them
.claude/worktrees/

# Internal growth & marketing strategy (local only — pricing, margins, CAC)
GROWTH_STRATEGY.md
MARKETING_*.md
*_STRATEGY.md

# app build
/out/
/.app-build/

# Capacitor: the native projects ARE committed so that manifest, gradle and
# signing config are reviewable and versioned. Only their build output is not.
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/capacitor-cordova-android-plugins/
/ios/App/build/
/ios/App/Pods/
/ios/App/App/public/
/ios/App/App/capacitor.config.json
DerivedData/

# Signing material and service account files. Never commit these — the
# pre-commit scanner blocks them too, this is the second line.
*.keystore
*.jks
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
