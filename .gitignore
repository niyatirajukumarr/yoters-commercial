# committed env dump (removed) — never re-add
env.download

# Load-test scripts that point at production (yoters.site) and their output.
# load-test-read.mjs is committed on purpose: it is reads-only and safe. These
# drive the write/payment path at 2400 concurrent users — not something that
# should sit in a public repo ready to run.
load-test.js
load-test-simple.js
load-test-results.txt

# Security & internal documentation (local development only)
# Audit reports, security reviews, vulnerability assessments
SECURITY_*.md
AUDIT*.md
*_AUDIT.md
DATA_PRIVACY*.md
DEPLOYMENT*.md

# Internal work logs and setup guides
progress.md
SETUP_*.md
TRANSFER.md
IMPLEMENTATION*.md
INVESTIGATION*.md

# Sensitive operational docs (never commit)
CREDENTIALS*.md
SECRETS*.md
TODO*.md
NOTES*.md
DEBUG*.md
TEST*.md
GROWTH_STRATEGY.md

# Stale worktree checkouts of this repo — 200MB+, and test runners walk them
.claude/worktrees/
